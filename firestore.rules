rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is admin?
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    match /jobs/{jobId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.postedBy.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        // Normal users cannot set featured fields
        && (request.resource.data.featured == false || request.resource.data.featured == null)
        && (request.resource.data.featuredUntil == null || request.resource.data.featuredUntil == null);

      // Owner can update content fields only
      allow update: if request.auth != null
        && resource.data.postedBy.uid == request.auth.uid
        && request.resource.data.postedBy == resource.data.postedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'category', 'location', 'description',
          'payMin', 'payMax', 'payType', 'phone', 'tags', 'type'
        ])
        // Owner cannot change featured fields
        && (request.resource.data.featured == resource.data.featured)
        && (request.resource.data.featuredUntil == resource.data.featuredUntil);

      // Anyone can save/unsave
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedBy']);

      // Anyone can increment views
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views is number
        && request.resource.data.views >= resource.data.views;

      // Only admin can set featured status
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['featured', 'featuredUntil']);

      allow delete: if request.auth != null
        && resource.data.postedBy.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
      }
    }

    // Payments collection (admin + owner)
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      allow update: if isAdmin();
    }
  }
}