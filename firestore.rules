rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /jobs/{jobId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.postedBy.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;

      allow update: if request.auth != null
        && resource.data.postedBy.uid == request.auth.uid
        && request.resource.data.postedBy == resource.data.postedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'category', 'location', 'description',
          'payMin', 'payMax', 'payType', 'phone', 'tags'
        ]);

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedBy']);

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views is number;

      allow delete: if request.auth != null
        && resource.data.postedBy.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
      }
    }
  }
}
